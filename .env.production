# Build-time settings for production builds (not secret; committed on purpose).
# Values set in the Vercel project settings override these.
#
# REACT_APP_DEMO_MODE: true = public demo (landing and sign-in pages show the demo logins).
# This is the one switch for a real deployment: set it to false (see the backend's docs/PRODUCTION.md).
REACT_APP_DEMO_MODE=true
