# Base URL of the EmploCore backend API (no trailing slash, no /api suffix).
# Falls back to the production Render URL if unset.
REACT_APP_API_URL=https://employee-management-system-backend-vxar.onrender.com

# Optional: request timeout in milliseconds (default 60000; free hosting can take ~a minute to wake up).
# REACT_APP_API_TIMEOUT_MS=60000

# Public demo (true) shows the demo logins on the landing and sign-in pages. Real deployments: false.
# Production builds read it from .env.production (true) unless Vercel sets it.
# REACT_APP_DEMO_MODE=false
